[Unit]
Description=IPTV HLS/CORS proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iptvproxy
Group=iptvproxy
WorkingDirectory=/opt/iptv-proxy
EnvironmentFile=/opt/iptv-proxy/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/iptv-proxy/server.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=256M
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iptv-proxy

[Install]
WantedBy=multi-user.target
